<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.16</string>
	<key>CFBundleVersion</key>
	<string>16</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Local mode + self-hosted transcription hit HTTP servers on localhost
		     or the LAN (ollama, llama-server, vLLM, whisper). Allow cleartext to
		     local/private networks without weakening ATS for the public internet. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Whispera connects to local AI servers (e.g. ollama or a self-hosted Whisper endpoint) on your machine or network for Local-mode transcription and recipe execution.</string>
	<!-- Clerk publishable keys are public by design (they ship in every Clerk
	     web bundle); the secret key lives only on the backend. Shipping it here
	     is what makes sign-in work in an installed .app, which inherits no
	     process environment. Override at runtime with CLERK_PUBLISHABLE_KEY. -->
	<key>ClerkPublishableKey</key>
	<string>pk_test_c2F2aW5nLW1hY2F3LTc4LmNsZXJrLmFjY291bnRzLmRldiQ</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>Whispera needs accessibility access to monitor global keyboard shortcuts.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Whispera needs access to your microphone to transcribe audio.</string>
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/sapoepsilon/Whispera/main/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>GbHOfW9t2r/mOlDit7usEnhy2upMdDdzNhFvHiKD7qU=</string>
</dict>
</plist>
