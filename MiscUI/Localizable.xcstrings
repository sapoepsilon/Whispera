    "Whispera needs access to your microphone to transcribe audio. Please grant permission in System Settings > Privacy & Security > Microphone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Whispera braucht Zugriff auf dein Mikrofon, um Audio zu transkribieren. Erteile die Berechtigung unter Systemeinstellungen > Datenschutz & Sicherheit > Mikrofon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Whispera necesita acceso al micrófono para transcribir audio. Concede el permiso en Ajustes del Sistema > Privacidad y seguridad > Micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whispera a besoin d'accéder à votre micro pour transcrire l'audio. Accordez l'autorisation dans Réglages Système > Confidentialité et sécurité > Micro."
          }
        }
      }
    },
    "Whispera needs accessibility permissions to work with global keyboard shortcuts.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
