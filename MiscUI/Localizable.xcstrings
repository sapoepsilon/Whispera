    "Whispera couldn't paste because Accessibility access is off. The transcript is on the clipboard. Turn Whispera on in System Settings > Privacy & Security > Accessibility.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Whispera konnte nicht einfügen, weil der Bedienungshilfen-Zugriff aus ist. Das Transkript liegt in der Zwischenablage. Aktiviere Whispera unter Systemeinstellungen > Datenschutz & Sicherheit > Bedienungshilfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Whispera no pudo pegar porque el acceso de Accesibilidad está desactivado. La transcripción está en el portapapeles. Activa Whispera en Ajustes del Sistema > Privacidad y seguridad > Accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whispera n'a pas pu coller car l'accès Accessibilité est désactivé. La transcription est dans le presse-papiers. Activez Whispera dans Réglages Système > Confidentialité et sécurité > Accessibilité."
          }
        }
      }
    },
    "Whispera couldn't type because Accessibility access is off. Turn Whispera on in System Settings > Privacy & Security > Accessibility.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Whispera konnte nicht tippen, weil der Bedienungshilfen-Zugriff aus ist. Aktiviere Whispera unter Systemeinstellungen > Datenschutz & Sicherheit > Bedienungshilfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Whispera no pudo escribir porque el acceso de Accesibilidad está desactivado. Activa Whispera en Ajustes del Sistema > Privacidad y seguridad > Accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whispera n'a pas pu saisir le texte car l'accès Accessibilité est désactivé. Activez Whispera dans Réglages Système > Confidentialité et sécurité > Accessibilité."
          }
        }
      }
    },
