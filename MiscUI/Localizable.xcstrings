    },
    "That key can't be used. Press Command, Option, Control or Shift + another key": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Taste kann nicht verwendet werden. Drücke Befehl, Wahl, Control oder Umschalt + eine weitere Taste"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
