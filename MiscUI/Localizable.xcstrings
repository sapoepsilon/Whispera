    "Neural uses the Silero model (downloaded once, about 1 MB) for recorded clips and is better at ignoring noise; Live Transcription Mode always uses Energy": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuronal nutzt das Silero-Modell (einmalig geladen, etwa 1 MB) für aufgenommene Clips und ignoriert Geräusche besser; der Live-Transkriptionsmodus nutzt immer Energie"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuronal usa el modelo Silero (se descarga una vez, unos 1 MB) para los clips grabados e ignora mejor el ruido; el modo de transcripción en vivo siempre usa Energía"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuronal utilise le modèle Silero (téléchargé une fois, environ 1 Mo) pour les extraits enregistrés et ignore mieux le bruit ; le mode de transcription en direct utilise toujours Énergie"
          }
        }
      }
    },
    "Never": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
