    "The repo must contain WhisperKit CoreML model folders. Enter the repo and the folder name, or paste a link to the folder.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Repository muss WhisperKit-CoreML-Modellordner enthalten. Gib das Repository und den Ordnernamen ein oder füge einen Link zum Ordner ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El repositorio debe contener carpetas de modelos CoreML de WhisperKit. Introduce el repositorio y el nombre de la carpeta, o pega un enlace a la carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dépôt doit contenir des dossiers de modèles CoreML WhisperKit. Saisissez le dépôt et le nom du dossier, ou collez un lien vers le dossier."
