    "No effect in Live Transcription Mode: WhisperKit opens the microphone for each recording. Turn Live Transcription Mode off to use this.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Wirkung im Live-Transkriptionsmodus: WhisperKit öffnet das Mikrofon für jede Aufnahme. Schalte den Live-Transkriptionsmodus aus, um dies zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin efecto en el modo de transcripción en vivo: WhisperKit abre el micrófono en cada grabación. Desactiva el modo de transcripción en vivo para usarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans effet en mode de transcription en direct : WhisperKit ouvre le micro à chaque enregistrement. Désactivez le mode de transcription en direct pour l'utiliser."
          }
        }
      }
    },
    "No effect with streaming transcription off: each recording opens the microphone to write a file.": {
