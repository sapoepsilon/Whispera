          }
        }
      }
    },
    "The shortcut \"%@\" could not be read, so it was reset to %@. Choose another one in Settings > General.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Kürzel „%@“ konnte nicht gelesen werden und wurde auf %@ zurückgesetzt. Wähle unter Einstellungen > Allgemein ein anderes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el atajo «%@», así que se restableció a %@. Elige otro en Ajustes > General."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
