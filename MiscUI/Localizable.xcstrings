            "state": "translated",
            "value": "Ce Mac a été retiré de votre compte. Reconnectez-vous pour l’ajouter à nouveau."
          }
        }
      }
    },
    "This Mac's approval key is missing. Set it up again in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Freigabeschlüssel dieses Mac fehlt. Richte ihn in den Einstellungen neu ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta la clave de aprobación de este Mac. Vuelve a configurarla en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé d’autorisation de ce Mac est introuvable. Configurez-la de nouveau dans les réglages."
          }
        }
      }
    },
    "This build was compiled without FoundationModels": {
      "extractionState": "manual",
      "localizations": {
