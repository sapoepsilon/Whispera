{
  "sourceLanguage": "en",
  "strings": {
    "\"Allow whispera:// links\" is off, so the commands that control Whispera will only tell you to turn it on. Turn it on in Settings > Automation.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„whispera://-Links erlauben“ ist aus, daher weisen die Befehle, die Whispera steuern, nur darauf hin, es einzuschalten. Schalte es unter Einstellungen > Automatisierung ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Permitir enlaces whispera://» está desactivado, así que los comandos que controlan Whispera solo te pedirán que lo actives. Actívalo en Ajustes > Automatización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Autoriser les liens whispera:// » est désactivé : les commandes qui contrôlent Whispera vous demanderont seulement de l'activer. Activez-le dans Réglages > Automatisation."
          }
        }
      }
    },
    "${output} is replaced with the transcript. Without it, the prompt becomes the instructions.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "${output} wird durch das Transkript ersetzt. Ohne diesen Platzhalter dient der Prompt als Anweisung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "${output} se sustituye por la transcripción. Sin él, la instrucción se usa como indicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "${output} est remplacé par la transcription. Sans lui, l'invite sert d'instructions."
          }
        }
      }
    },
    "%@ and its downloaded files will be deleted.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ und die geladenen Dateien werden gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán %@ y sus archivos descargados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ et ses fichiers téléchargés seront supprimés."
          }
        }
      }
    },
    "%@ audio": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Audio"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de audio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ d'audio"
          }
        }
      }
    },
    "%@ could not be played as a sound.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht als Ton abgespielt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no se pudo reproducir como sonido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire %@ comme son."
          }
        }
      }
    },
    "%@ disconnected, so the recording was stopped. What was captured was transcribed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde getrennt, daher wurde die Aufnahme beendet. Das bisher Aufgenommene wurde transkribiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se desconectó, así que la grabación se detuvo. Se transcribió lo que se había capturado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été déconnecté, l’enregistrement a donc été arrêté. Ce qui avait été capturé a été transcrit."
          }
        }
      }
    },
    "%@ disconnected. Using the system default microphone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde getrennt. Das Standardmikrofon des Systems wird verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se desconectó. Se usa el micrófono predeterminado del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été déconnecté. Le micro par défaut du système est utilisé."
          }
        }
      }
    },
    "%@ has turned on Secure Input": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat die sichere Eingabe aktiviert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha activado la entrada segura"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a activé la saisie sécurisée"
          }
        }
      }
    },
    "%@ is already used by another Whispera shortcut (%@).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird bereits von einem anderen Whispera-Kurzbefehl verwendet (%@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya lo usa otro atajo de Whispera (%@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est déjà utilisé par un autre raccourci Whispera (%@)."
          }
        }
      }
    },
    "%@ is not downloaded. Download it again in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht geladen. Lade es in den Einstellungen erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no está descargado. Vuelve a descargarlo en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'est pas téléchargé. Téléchargez-le à nouveau dans les Réglages."
          }
        }
      }
    },
    "%@ is still loading, so this dictation could not be transcribed. Try again once it is ready, or pick another model in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird noch geladen, daher konnte dieses Diktat nicht transkribiert werden. Versuche es erneut, sobald es bereit ist, oder wähle in den Einstellungen ein anderes Modell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ todavía se está cargando, así que este dictado no se pudo transcribir. Vuelve a intentarlo cuando esté listo o elige otro modelo en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est encore en cours de chargement, cette dictée n'a donc pas pu être transcrite. Réessayez quand il sera prêt ou choisissez un autre modèle dans les Réglages."
          }
        }
      }
    },
    "%@ left": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "noch %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "quedan %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ restantes"
          }
        }
      }
    },
    "%@ to stop": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zum Stoppen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ para detener"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pour arrêter"
          }
        }
      }
    },
    "%@ token": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Token „%@“"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Token %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeton %@"
          }
        }
      }
    },
    "%@ types text, so it needs a modifier such as ⌘, ⌥ or ⌃. Esc, Delete and the F-keys work on their own.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tippt Text und braucht deshalb eine Sondertaste wie ⌘, ⌥ oder ⌃. Esc, Löschen und die F-Tasten funktionieren allein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ escribe texto, así que necesita un modificador como ⌘, ⌥ o ⌃. Esc, Borrar y las teclas F funcionan solas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ saisit du texte : ajoutez une touche de modification comme ⌘, ⌥ ou ⌃. Échap, Supprimer et les touches F fonctionnent seules."
          }
        }
      }
    },
    "%@ wants to approve secrets on this Mac": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ möchte Geheimnisse auf diesem Mac freigeben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quiere aprobar secretos en este Mac"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ souhaite approuver des secrets sur ce Mac"
          }
        }
      }
    },
