    },
    "This feature is in active development and improvements are coming soon.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Funktion wird aktiv weiterentwickelt, Verbesserungen folgen bald."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta función está en pleno desarrollo y pronto llegarán mejoras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette fonctionnalité est en cours de développement et des améliorations arrivent bientôt."
          }
        }
      }
    },
    "This iPhone's keys changed while the card was open. Compare the new safety number before you confirm.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schlüssel dieses iPhones haben sich geändert, während die Karte offen war. Vergleiche die neue Sicherheitsnummer, bevor du bestätigst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves de este iPhone cambiaron mientras la tarjeta estaba abierta. Compara el nuevo número de seguridad antes de confirmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés de cet iPhone ont changé pendant que la carte était ouverte. Comparez le nouveau numéro de sécurité avant de confirmer."
          }
        }
      }
    },
    "This removes every item, including completed and failed transcriptions.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit werden alle Einträge entfernt, auch abgeschlossene und fehlgeschlagene Transkriptionen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina todos los elementos, incluidas las transcripciones completadas y fallidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime tous les éléments, y compris les transcriptions terminées et en échec."
          }
        }
      }
    },
    "This will permanently delete all application logs. This action cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Programmprotokolle werden dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán de forma permanente todos los registros de la aplicación. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les journaux de l'application seront supprimés définitivement. Cette action est irréversible."
          }
        }
      }
    },
    "This will permanently delete all downloaded WhisperKit models. You'll need to re-download them if you want to use them again.\n\nStorage to be freed: %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle geladenen WhisperKit-Modelle werden dauerhaft gelöscht. Du musst sie erneut laden, wenn du sie wieder nutzen willst.\n\nFreizugebender Speicher: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán de forma permanente todos los modelos de WhisperKit descargados. Tendrás que volver a descargarlos si quieres usarlos de nuevo.\n\nEspacio que se liberará: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les modèles WhisperKit téléchargés seront définitivement supprimés. Vous devrez les retélécharger pour les réutiliser.\n\nEspace libéré : %@"
          }
        }
      }
    },
