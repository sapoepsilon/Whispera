      }
    },
    "This deletes %lld entries and their recordings now. Starred entries are kept.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden jetzt %lld Einträge und ihre Aufnahmen gelöscht. Markierte Einträge bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán ahora %lld entradas y sus grabaciones. Las entradas destacadas se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime maintenant %lld entrées et leurs enregistrements. Les entrées favorites sont conservées."
          }
        }
      }
    },
    "This device's keys changed. If you didn't reinstall Whispera on it, don't confirm.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schlüssel dieses Geräts haben sich geändert. Wenn du Whispera darauf nicht neu installiert hast, bestätige nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves de este dispositivo cambiaron. Si no reinstalaste Whispera en él, no lo confirmes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés de cet appareil ont changé. Si vous n’y avez pas réinstallé Whispera, ne confirmez pas."
          }
        }
      }
    },
    "This entry has no transcript to post-process.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
