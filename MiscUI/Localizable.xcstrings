            "value": "Melde dich auf diesem Mac und deinem iPhone mit demselben Konto an, dann finden sie sich – ohne Kopplungscode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en este Mac y en tu iPhone con la misma cuenta y se encontrarán solos, sin código de emparejamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous sur ce Mac et sur votre iPhone avec le même compte : ils se trouvent seuls, sans code de jumelage."
          }
        }
      }
    },
