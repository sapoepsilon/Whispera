        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält das Audio, damit Einträge erneut abgespielt oder transkribiert werden können. Aufnahmen bleiben auf diesem Mac und sind von Time-Machine-Backups ausgenommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el audio para poder reproducir o volver a transcribir las entradas. Las grabaciones se quedan en este Mac y no se incluyen en las copias de Time Machine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve l'audio pour pouvoir réécouter ou retranscrire les entrées. Les enregistrements restent sur ce Mac et sont exclus des sauvegardes Time Machine."
