    "A recipe runs an AI step on your dictation when you say its trigger phrase.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Rezept wendet einen KI-Schritt auf dein Diktat an, wenn du seine Auslösephrase sagst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una receta aplica un paso de IA a tu dictado cuando dices su frase de activación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une recette applique une étape d'IA à votre dictée quand vous dites sa phrase de déclenchement."
          }
        }
      }
    },
    "A short tap toggles recording; holding past the threshold records until release": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzes Tippen startet oder stoppt die Aufnahme; hältst du länger als der Schwellenwert, wird bis zum Loslassen aufgenommen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pulsación corta activa o detiene la grabación; si mantienes pulsado más allá del umbral, se graba hasta que sueltes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appui bref active ou arrête l'enregistrement ; au-delà du seuil, l'enregistrement dure jusqu'au relâchement"
          }
        }
      }
    },
    "A token your self-hosted server accepts. It is kept in the Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Token, das dein eigener Server akzeptiert. Es wird im Schlüsselbund gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un token que acepta tu servidor propio. Se guarda en el llavero."
          }
        },
