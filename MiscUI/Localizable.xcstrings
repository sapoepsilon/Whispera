      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Whispera nicht in den Mikrofoneinstellungen erscheint, starte zuerst eine Aufnahme, um die Berechtigungsanfrage auszulösen."
          }
        },
