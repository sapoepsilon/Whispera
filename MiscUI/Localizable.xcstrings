          }
        }
      }
    },
    "The transcript stays on the clipboard at least this long after Cmd-V before the previous clipboard returns": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Transkript bleibt nach Cmd-V mindestens so lange in der Zwischenablage, bevor der vorherige Inhalt zurückkehrt"
