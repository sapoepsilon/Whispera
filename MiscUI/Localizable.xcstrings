    "Add a WhisperKit CoreML model from a Hugging Face repo, or import a local folder containing MelSpectrogram, AudioEncoder and TextDecoder.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein WhisperKit-CoreML-Modell aus einem Hugging-Face-Repository hinzu oder importiere einen lokalen Ordner mit MelSpectrogram, AudioEncoder und TextDecoder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un modelo CoreML de WhisperKit desde un repositorio de Hugging Face o importa una carpeta local que contenga MelSpectrogram, AudioEncoder y TextDecoder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un modèle CoreML WhisperKit depuis un dépôt Hugging Face, ou importez un dossier local contenant MelSpectrogram, AudioEncoder et TextDecoder."
          }
        }
      }
    },
    "Add a space after each transcript so the next one does not run into it": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt nach jedem Transkript ein Leerzeichen ein, damit das nächste nicht direkt anschließt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un espacio tras cada transcripción para que la siguiente no quede pegada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute une espace après chaque transcription pour que la suivante ne soit pas collée"
          }
        }
      }
    },
    "Add audio or video files to start transcription": {
