          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el audio para poder reproducir o volver a transcribir las entradas. El historial y las grabaciones se quedan en este Mac y se excluyen de las copias de Time Machine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve l'audio pour pouvoir réécouter ou retranscrire les entrées. L'historique et les enregistrements restent sur ce Mac et sont exclus des sauvegardes Time Machine."
