      }
    },
    "New recordings are no longer saved. Delete the recordings already saved? The text of each entry is kept.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Aufnahmen werden nicht mehr gespeichert. Bereits gespeicherte Aufnahmen löschen? Der Text jedes Eintrags bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones nuevas ya no se guardan. ¿Eliminar las grabaciones ya guardadas? El texto de cada entrada se conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux enregistrements ne sont plus sauvegardés. Supprimer les enregistrements déjà sauvegardés ? Le texte de chaque entrée est conservé."
          }
        }
      }
    },
