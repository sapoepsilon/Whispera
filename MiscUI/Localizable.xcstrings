    "Drop um, uh, hmm and repeated stutters from dictation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt „äh“, „ähm“, „hm“ und wiederholtes Stottern aus Diktaten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita «eh», «em», «mmm» y los tartamudeos repetidos del dictado"
