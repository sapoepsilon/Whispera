{
  "sourceLanguage": "en",
  "strings": {
    "${output} is replaced with the transcript. Without it, the prompt becomes the instructions.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "${output} wird durch das Transkript ersetzt. Ohne diesen Platzhalter dient der Prompt als Anweisung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "${output} se sustituye por la transcripción. Sin él, la instrucción se usa como indicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "${output} est remplacé par la transcription. Sans lui, l'invite sert d'instructions."
          }
        }
      }
    },
    "%@ and its downloaded files will be deleted.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ und die geladenen Dateien werden gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán %@ y sus archivos descargados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ et ses fichiers téléchargés seront supprimés."
          }
        }
      }
    },
    "%@ audio": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Audio"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de audio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ d'audio"
          }
        }
      }
    },
    "%@ could not be played as a sound.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht als Ton abgespielt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no se pudo reproducir como sonido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire %@ comme son."
          }
        }
      }
    },
    "%@ has turned on Secure Input": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat die sichere Eingabe aktiviert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha activado la entrada segura"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a activé la saisie sécurisée"
          }
        }
      }
    },
    "%@ is already used by another Whispera shortcut (%@).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird bereits von einem anderen Whispera-Kurzbefehl verwendet (%@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya lo usa otro atajo de Whispera (%@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est déjà utilisé par un autre raccourci Whispera (%@)."
          }
        }
      }
    },
    "%@ types text, so it needs a modifier such as ⌘, ⌥ or ⌃. Esc, Delete and the F-keys work on their own.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tippt Text und braucht deshalb eine Sondertaste wie ⌘, ⌥ oder ⌃. Esc, Löschen und die F-Tasten funktionieren allein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ escribe texto, así que necesita un modificador como ⌘, ⌥ o ⌃. Esc, Borrar y las teclas F funcionan solas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ saisit du texte : ajoutez une touche de modification comme ⌘, ⌥ ou ⌃. Échap, Supprimer et les touches F fonctionnent seules."
          }
        }
      }
    },
