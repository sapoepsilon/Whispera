    "Models are downloaded once and stored locally. Your voice data never leaves your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelle werden einmal geladen und lokal gespeichert. Deine Sprachdaten verlassen nie deinen Mac."
          }
        },
