    "This will permanently delete all application logs. This action cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Programmprotokolle werden dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán de forma permanente todos los registros de la aplicación. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les journaux de l'application seront supprimés définitivement. Cette action est irréversible."
          }
        }
      }
    },
    "This will permanently delete all downloaded WhisperKit models. You'll need to re-download them if you want to use them again.\n\nStorage to be freed: %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle geladenen WhisperKit-Modelle werden dauerhaft gelöscht. Du musst sie erneut laden, wenn du sie wieder nutzen willst.\n\nFreizugebender Speicher: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán de forma permanente todos los modelos de WhisperKit descargados. Tendrás que volver a descargarlos si quieres usarlos de nuevo.\n\nEspacio que se liberará: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les modèles WhisperKit téléchargés seront définitivement supprimés. Vous devrez les retélécharger pour les réutiliser.\n\nEspace libéré : %@"
          }
        }
      }
    },
