    "New dictations are no longer saved. Delete the %lld entries already in history, including starred ones and their recordings?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Diktate werden nicht mehr gespeichert. Die %lld Einträge im Verlauf löschen, einschließlich markierter Einträge und ihrer Aufnahmen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dictados nuevos ya no se guardan. ¿Eliminar las %lld entradas que ya están en el historial, incluidas las destacadas y sus grabaciones?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles dictées ne sont plus enregistrées. Supprimer les %lld entrées déjà dans l'historique, y compris les favorites et leurs enregistrements ?"
          }
        }
      }
    },
