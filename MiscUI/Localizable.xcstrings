            "value": "Wird in nicht nativen Apps (Chrome, VSCode, Electron-Apps) eventuell falsch platziert. Dann wird die Position des letzten Mausklicks verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede no colocarse bien en apps no nativas (Chrome, VSCode, apps de Electron). En ese caso usa la posición del último clic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
