    "Tip: Choose less common combinations like ⌃⌥W or ⌘⇧R": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Wähle seltenere Kombinationen wie ⌃⌥W oder ⌘⇧R"
          }
        },
        "es": {
          "stringUnit": {
