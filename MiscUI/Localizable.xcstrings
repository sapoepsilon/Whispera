    "Plain http to %@ would expose your API key, so Whispera will not send it. Use https://.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unverschlüsseltes http zu %@ würde deinen API-Schlüssel offenlegen, daher sendet Whispera ihn nicht. Verwende https://."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El http sin cifrar hacia %@ expondría tu clave de API, así que Whispera no la enviará. Usa https://."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le http non chiffré vers %@ exposerait votre clé d'API, Whispera ne l'enverra donc pas. Utilisez https://."
          }
        }
      }
